# ============================================================================
# Agent Suite configuration. Copy to .env and fill in.
# Everything has a safe default; the suite runs with none of it set.
# ============================================================================

# ---- safety -----------------------------------------------------------------
# While true, nothing is actually sent. Leave it on until you have watched a
# few runs and read what the agents want to send.
DRY_RUN=true
DRY_RUN_PRINT=true

# ---- who you are ------------------------------------------------------------
OPERATOR_NAME=Vineet
OPERATOR_EMAIL=you@yourdomain.com
TIMEZONE=Asia/Kolkata

# ---- the language model -----------------------------------------------------
# offline | ollama | openai | anthropic
#
# 'ollama' runs a model on this machine. Nothing is sent anywhere, there is no
# bill, and the agent reads each brand's own website before writing - so a
# nutrition brand and a camera brand get different emails instead of the same
# template. This is the recommended setting.
#
# 'offline' needs no model at all: drafting falls back to written templates
# assembled from crawled facts. Every agent runs end to end in this mode, and
# it is also what happens automatically if the model is switched off mid-run.
LLM_PROVIDER=ollama

# Install Ollama from ollama.com, then pull a model:
#     ollama pull qwen2.5:7b-instruct
# 7B is the sweet spot here - it follows the brief and stays on format. On a
# machine with little memory, qwen2.5:3b-instruct works; on 16GB+ of VRAM,
# qwen2.5:14b-instruct is noticeably better at reading a site.
# `python run.py doctor` says which models are installed.
LLM_MODEL=qwen2.5:7b-instruct
OLLAMA_BASE_URL=http://localhost:11434
# Ollama's own default is 2048 tokens, which cuts the brand's website out of
# the prompt. Do not lower this.
OLLAMA_NUM_CTX=8192
# Keeps the model in memory between brands instead of reloading for each one.
OLLAMA_KEEP_ALIVE=10m
OLLAMA_THINK=false
OLLAMA_NUM_GPU=99
OLLAMA_NUM_BATCH=256
# If the model is unreachable or answers with junk, use the written template
# for that brand rather than ending the run.
LLM_FALLBACK_OFFLINE=true

# LM Studio, llama.cpp and vLLM instead of Ollama: set LLM_PROVIDER=openai and
# point OPENAI_BASE_URL at them. No key is needed for a local server.
# OPENAI_BASE_URL=http://localhost:1234/v1

# Hosted models, if you ever want one:
# ANTHROPIC_API_KEY=sk-ant-...      (with LLM_PROVIDER=anthropic)
# OPENAI_API_KEY=sk-...             (with LLM_PROVIDER=openai)
LLM_CACHE=true

# Operator preferences. Leave application answers blank until supplied.
JOB_MIN_MONTHLY_INR=50000
FREELANCE_MIN_PROJECT_INR=10000
FREELANCE_MIN_PROJECT_USD=150
JOB_AUTO_APPLICATIONS=true
BROWSER_CHANNEL=chrome
BROWSER_HEADLESS=true
FOLLOWUP_DAYS=5
FOLLOWUP_MAX=2
COMMUNITY_MAX_PER_RUN=3

# ---- database ---------------------------------------------------------------
# SQLite needs nothing installed. Postgres needs `pip install psycopg[binary]`.
DB_URL=sqlite:///data/agentsuite.db
# DB_URL=postgresql://agent:agent@localhost:5432/agentsuite

# ---- sending mail -----------------------------------------------------------
MAIL_TRANSPORT=smtp                 # smtp | gmail
SENDER_EMAIL=you@yourdomain.com
SENDER_NAME=Your Name
# Required by anti-spam law in most jurisdictions. A real postal address.
SENDER_POSTAL_ADDRESS=Street, City, State, India
SMTP_HOST=smtp.yourprovider.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true
SMTP_REQUIRE_TLS=true
# Per-mailbox daily ceiling. Above ~50 you are gambling with your domain.
DAILY_SEND_CAP=30
# Signs unsubscribe links. Change it; never share it.
UNSUBSCRIBE_SECRET=change-me-to-something-random

# ---- Google (Gmail + Calendar) ----------------------------------------------
# Create an OAuth client of type "Desktop app" in Google Cloud Console, then
# run: python run.py auth google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# or point at the downloaded file instead of the two values above
# GOOGLE_CLIENT_SECRETS_FILE=./credentials.json
GMAIL_USER_ID=me
# Only needed for real-time push. Without it, `run.py inbox` polls instead.
# PUBSUB_TOPIC=projects/your-project/topics/gmail-push
# PUBSUB_TOKEN=a-shared-secret-in-the-push-url
CALENDAR_ID=primary

# ---- dashboard --------------------------------------------------------------
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8080
# Anyone who can reach the port and knows this can approve sends. Set it.
DASHBOARD_TOKEN=
# Used in unsubscribe links, so it must be reachable by recipients if you want
# one-click unsubscribe to work.
PUBLIC_BASE_URL=http://localhost:8080
# Read-only mode for showing the console to somebody: email addresses, phone
# numbers and keys are blanked out, and nothing can be approved, rejected, run
# or downloaded. `python run.py serve --demo` turns it on for one session.
DEMO_MODE=false

# ---- telegram ---------------------------------------------------------------
# Control all four agents from your phone. Message @BotFather on Telegram,
# send /newbot, and paste the token it gives you here. Then:
#   1. make a group, open Edit -> Topics and turn Topics on
#   2. add your bot to the group and make it an admin with "Manage Topics"
#   3. run `python run.py telegram` and send /start in the group
# TELEGRAM_BOT_TOKEN=123456789:AA...
#
# The first person to send /start is remembered as the owner and nobody else
# can drive the bot. Set this to pin it to your own Telegram user id instead
# (send /id to the bot to find out what yours is).
# TELEGRAM_OWNER_ID=

# ---- notifications ----------------------------------------------------------
# console,store,telegram,ntfy,webhook,slack,discord,email
# Add `telegram` once the bot is set up and every agent event reaches your phone.
NOTIFY_CHANNELS=console,store
# NTFY_TOPIC=vineet-agents
# NTFY_URL=https://ntfy.sh
# SLACK_WEBHOOK_URL=
# DISCORD_WEBHOOK_URL=

# ---- lead discovery ---------------------------------------------------------
# seeds | brave | serper | searxng
# 'seeds' reads profiles/targets.yaml. For a niche list, curated beats scraped.
SEARCH_PROVIDER=seeds
SEEDS_FILE=./profiles/targets.yaml
# BRAVE_API_KEY=
# SERPER_API_KEY=
# SEARXNG_URL=

# ---- crawling -----------------------------------------------------------
USER_AGENT=AgentSuite/1.0 (+contact: you@yourdomain.com)
RESPECT_ROBOTS=true
CRAWL_MIN_INTERVAL=1.5
CRAWL_MAX_PAGES=6
CRAWL_TIMEOUT=20

# ---- per-agent tuning -------------------------------------------------------
SPONSORSHIP_MAX_LEADS=10
SPONSORSHIP_MIN_SCORE=0.35
# SPONSORSHIP_CATEGORY=fantasy_sports
VIDEO_CLIENT_MAX_LEADS=10
VIDEO_CLIENT_MIN_SCORE=0.35
# VIDEO_CLIENT_CATEGORY=creator
FULLSTACK_MAX_LEADS=10
FULLSTACK_MIN_SCORE=0.35
# FULLSTACK_CATEGORY=software_prospect
YOUTUBE_CHANNEL_URL=
PORTFOLIO_URL=
VIDEO_RATES_FILE=./profiles/video_rates.yaml
PRICING_FILE=./profiles/dev_rate_card.yaml

# ---- job hunting ------------------------------------------------------------
# greenhouse,lever,remotive,remoteok,adzuna,jsonfeed,fixture
# Where to look. greenhouse and lever read a company's own board directly and
# are by far the best signal - real roles, full descriptions, no middleman.
# remotive and remoteok are remote-only and skew senior; they are a top-up.
JOB_SOURCES=greenhouse,remotive,remoteok

# Company boards to read. These are all live and verified. Add any company you
# want to work at: open their careers page and the board token is in the URL
# (job-boards.greenhouse.io/<token>).
GREENHOUSE_BOARDS=razorpaysoftwareprivatelimited,postman,groww,netradyne,highradius,hackerrank,sigmacomputing,observeai,turing,scaleai,databricks,anthropic,mongodb,elastic,gitlab,stripe,coinbase,twilio

# What counts as "a job for me". Anything whose title does not match one of
# these is dropped before you ever see it - this is what stops sales and
# service-desk roles reaching your phone.
# Options: software java python ai_ml agentic_ai forward_deployed
#          data_engineering data_analysis devops
JOB_ROLE_FAMILIES=software,java,python,ai_ml,agentic_ai,forward_deployed,data_engineering,data_analysis

# Your years of experience. Change it from Telegram with /exp 1, /exp 2 - it
# gets written back here so it survives a restart.
JOB_EXPERIENCE_YEARS=0
# How far above your level to still show. 0 years + 2 slack means you see
# postings asking for up to 2 years, and nothing more senior.
JOB_EXPERIENCE_SLACK=2

# Searches sent to boards that take a query string.
JOB_QUERIES=software engineer,backend engineer,full stack developer,java developer,python developer,data engineer,data analyst,AI engineer,machine learning engineer,forward deployed engineer

# Adzuna covers Indian (non-remote) listings far better than any remote board.
# A free key takes a minute: https://developer.adzuna.com/signup
# Add `adzuna` to JOB_SOURCES once you have filled these in.
# ADZUNA_APP_ID=
# ADZUNA_APP_KEY=
# ADZUNA_COUNTRY=in
JOB_MAX_PER_RUN=25
JOB_MAX_AGE_DAYS=30
RESUME_MASTER_FILE=./profiles/master_resume.yaml
RESUME_VIDEO_FILE=./profiles/master_resume_video.yaml
RESUME_OUTPUT_DIR=./data/resumes
# LEVER_COMPANIES=some-company
INTERVIEW_MINUTES=45
SCHEDULE_DAYS_AHEAD=7
SCHEDULE_MAX_SLOTS=4
SCHEDULE_LEAD_HOURS=18

# ---- scheduler --------------------------------------------------------------
INBOX_POLL_SECONDS=300
OUTREACH_INTERVAL_SECONDS=86400
# agents run automatically by `run.py schedule` - leave empty to run manually
SCHEDULED_AGENTS=

# ---- logging ----------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FORMAT=text                      # text | json

# ---------------------------------------------------------------------------
# SPONSORSHIP AGENT
# ---------------------------------------------------------------------------
# Your brand list and your numbers. See docs/SPONSORSHIP.md.
SPONSOR_FILE=profiles/sponsors.yaml
CREATOR_PROFILE=profiles/creator.yaml

# Brands per run. One reply in fifty is a normal cold-outreach rate, so a small
# number here cannot work by design - the whole point is volume.
# Which kinds of deal to chase. The point is brands PAYING for a promotion, so
# affiliate is deliberately left out - add it only if you want to earn a cut of
# other people's sales as well.
SPONSORSHIP_DEAL_TYPES=cash,agency,barter

SPONSORSHIP_MAX_LEADS=40
# The list is ordered so the deals that pay soonest come first - affiliate
# programmes, then agency rosters, then barter, then paid partnerships.
SPONSORSHIP_MIN_SCORE=0.30

# When a brand publishes no address, allow a standard pattern like
# partnerships@theirdomain.com - checked against their mail server first, and
# labelled as a guess everywhere it appears. Set false to only ever use
# addresses they published themselves.
CONTACT_GUESS_ENABLED=true

# Identify as an ordinary browser when reading a site. A bot User-Agent gets a
# 403 from a large share of commercial sites, which made real brands look dead.
# robots.txt is still honoured either way.
CRAWL_BROWSER_UA=true

# ---------------------------------------------------------------------------
# THE PROSPECTOR - finds new sponsors on its own
# ---------------------------------------------------------------------------
# How many candidates to read per sweep, and how many to put in front of you.
PROSPECT_MAX_CHECK=40
PROSPECT_MAX_PROPOSE=15

# How Indian a site has to look before it is worth pitching. 0.3 is roughly
# "rupee prices, or an Indian address, or a +91 number". Raise it to 0.5 to
# only accept brands with several Indian signals.
PROSPECT_INDIA_MIN=0.30

# Verification is a quick look, not a full crawl.
PROSPECT_CRAWL_PAGES=3
PROSPECT_CRAWL_TIMEOUT=10

# YouTube rate-limits hard. Seconds to wait between video pages when mining
# other cricket channels for who is already sponsoring them.
YOUTUBE_MINE_PAUSE=2.0

# The scheduler runs a sweep this often. Weekly is plenty.
DISCOVER_ENABLED=true
# Which sources an automatic sweep uses. YouTube mining and open web search
# work but are slow and rate-limited, so they are left out of the automatic
# sweep - run them on demand with /discover youtube or /discover web_search.
DISCOVER_SOURCES=cuelinks,trade_press,admitad
DISCOVER_INTERVAL_SECONDS=604800

# ---------------------------------------------------------------------------
# READING REPLIES
# ---------------------------------------------------------------------------
# Replies are read over IMAP using the SAME app password that sends the mail,
# so there is nothing extra to set up. Host and port are worked out from the
# address; set these only if your provider is unusual.
# INBOX_TRANSPORT=imap        # imap | gmail  (default: imap when MAIL_TRANSPORT=smtp)
# IMAP_HOST=imap.gmail.com
# IMAP_PORT=993
# IMAP_USER=                  # defaults to SMTP_USER
# IMAP_PASSWORD=              # defaults to SMTP_PASSWORD
# IMAP_FOLDER=INBOX
IMAP_LOOKBACK_DAYS=7
