{
  "name": "cortana-desktop",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs tests/*.test.mjs",
    "test:desktop": "electron tests/electron-smoke.cjs",
    "test:screen": "electron tests/electron-acceptance.cjs",
    "test:integrations": "electron tests/electron-integrations.cjs",
    "test:startup": "electron tests/electron-startup.cjs",
    "dev": "vite",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "electron": "electron .",
    "dev:all": "concurrently -k \"npm:dev\" \"wait-on http://localhost:5173 && cross-env CORTANA_DEV=1 electron .\"",
    "dist": "npm run build && electron-builder"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "concurrently": "^9.0.0",
    "cross-env": "^7.0.3",
    "electron": "44.9.1",
    "electron-builder": "26.15.3",
    "oxlint": "^1.75.0",
    "vite": "^8.2.0",
    "wait-on": "^8.0.0"
  },
  "build": {
    "appId": "com.cortana.assistant",
    "productName": "Cortana",
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis"
    }
  }
}
