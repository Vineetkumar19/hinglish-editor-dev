{
  "manifest_version": 3,
  "name": "Cortana Selected Workspace",
  "version": "1.0.0",
  "description": "Capture selected tabs and restore reviewed workspaces through the local Cortana broker.",
  "permissions": ["activeTab", "tabs", "storage", "nativeMessaging", "scripting"],
  "optional_host_permissions": ["https://www.youtube.com/*"],
  "background": {"service_worker": "worker.js"},
  "action": {"default_popup": "popup.html"},
  "incognito": "not_allowed"
}
