  "demo_phrases": [
    {
      "text": "Imagine a monument",
      "hero": 2,
      "motion": "in"
    },
    {
      "text": "that changes with the light.",
      "hero": 1,
      "motion": "out"
    },
    {
      "text": "The Taj Mahal",
      "hero": 2,
      "motion": "in"
    },
    {
      "text": "stands beside the Yamuna River",
      "hero": 3,
      "motion": "in"
    },
    {
      "text": "in Agra.",
      "hero": 1,
      "motion": "out"
    },
    {
      "text": "Its white marble",
      "hero": 2,
      "motion": "in"
    },
    {
      "text": "glows softly at sunrise",
      "hero": 0,
      "motion": "in"
    },
    {
      "text": "and shines beneath the moon.",
      "hero": 1,
      "motion": "out"
    },
    {
      "text": "Look closer at",
      "hero": 1,
      "motion": "in"
    },
    {
      "text": "the carved flowers,",
      "hero": 2,
      "motion": "in"
    },
    {
      "text": "the balanced gardens,",
      "hero": 2,
      "motion": "out"
    },
    {
      "text": "and the reflections",
      "hero": 2,
      "motion": "in"
    },
    {
      "text": "in the water.",
      "hero": 2,
      "motion": "in"
    },
    {
      "text": "Every detail invites you",
      "hero": 1,
      "motion": "out"
    },
    {
      "text": "to slow down.",
      "hero": 1,
      "motion": "in"
    },
    {
      "text": "Some places are more",
      "hero": 1,
      "motion": "in"
    },
    {
      "text": "than buildings.",
      "hero": 1,
      "motion": "out"
    },
    {
      "text": "They become stories that",
