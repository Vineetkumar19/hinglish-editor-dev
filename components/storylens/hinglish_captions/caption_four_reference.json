      "motion": "in",
      "header_inset": -68,
      "footer_outset": 58,
      "footer_bold": true,
      "footer_size": 108
    },
    {
      "text": "in the water.",
      "hero": 2,
      "motion": "in",
      "header_inset": -60,
      "footer_outset": 40
    },
    {
      "text": "Every detail invites you",
      "hero": 1,
