      "motion": "in",
      "header_inset": -68,
      "footer_outset": 58,
      "footer_bold": true,
      "footer_size": 108
    },
    {
      "text": "glows softly at sunrise",
      "hero": 0,
      "motion": "in",
      "header_inset": -60,
      "footer_outset": 40
    },
    {
      "text": "and shines beneath the moon.",
      "hero": 1,
      "motion": "out",
      "header_inset": 24
    },
    {
      "text": "Look closer at",
      "hero": 1,
      "motion": "in",
