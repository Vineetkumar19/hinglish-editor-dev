  "demo_phrases": [
    {
      "text": "Imagine a monument",
      "hero": 2,
      "motion": "in",
      "header_inset": -60,
      "footer_outset": 40
    },
    {
      "text": "that changes with the light.",
      "hero": 1,
      "motion": "out",
      "header_inset": 24
    },
    {
      "text": "The Taj Mahal",
      "hero": 2,
      "motion": "in",
      "header_alignment": "center"
    },
    {
      "text": "stands beside the Yamuna River",
      "hero": 3,
      "motion": "in",
      "header_inset": -56
    },
    {
      "text": "in Agra.",
      "hero": 1,
      "motion": "out",
      "header_inset": -12,
      "footer_bold": true,
      "footer_size": 88
    },
    {
      "text": "Its white marble",
