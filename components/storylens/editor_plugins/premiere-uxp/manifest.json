{
  "manifestVersion": 5,
  "id": "com.hinglish.editor.uxp",
  "name": "Storylens",
  "version": "1.0.0",
  "main": "index.html",
  "host": {
    "app": "premierepro",
    "minVersion": "25.6.0"
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "hinglishEditorPanel",
      "label": {
        "default": "Storylens"
      },
      "minimumSize": {
        "width": 280,
        "height": 350
      },
      "preferredDockedSize": {
        "width": 390,
        "height": 650
      }
    }
  ],
  "requiredPermissions": {
    "network": {
      "domains": [
        "http://127.0.0.1:8765"
      ]
    },
    "localFileSystem": "fullAccess",
    "launchProcess": {
      "schemes": [
        "http"
      ]
    },
    "webview": {
      "allow": "yes",
      "domains": [
        "http://127.0.0.1:8765"
      ],
      "enableMessageBridge": "localAndRemote"
    }
  }
}