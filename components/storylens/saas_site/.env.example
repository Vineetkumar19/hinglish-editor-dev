# Store real values in your hosting secret settings, never in this file.
HINGLISH_SAAS_ORIGIN=https://editor.your-domain.example
HINGLISH_SAAS_PRODUCTION=1
HINGLISH_SAAS_DATABASE_URL=mysql+pymysql://storylens_app:URL_ENCODED_PASSWORD@127.0.0.1:3306/storylens
# For a remote database, append ?ssl_ca=/private/mysql-ca.pem&ssl_verify_cert=true&ssl_verify_identity=true
HINGLISH_SAAS_DATA_DIR=/data/hinglish
HINGLISH_SAAS_SALES_ENABLED=0
HINGLISH_SAAS_WORKER_ENABLED=0
HINGLISH_SAAS_TOOLS=clean
HINGLISH_SAAS_UPLOAD_LIMIT_GB=2
HINGLISH_SAAS_UPLOAD_STORAGE_GB=10
HINGLISH_SAAS_JOBS_MONTH=20
HINGLISH_SAAS_JOB_TIMEOUT_SECONDS=3600
HINGLISH_SAAS_RAZORPAY_KEY_ID=
HINGLISH_SAAS_RAZORPAY_KEY_SECRET=
HINGLISH_SAAS_RAZORPAY_WEBHOOK_SECRET=
HINGLISH_SAAS_SMTP_HOST=
HINGLISH_SAAS_SMTP_PORT=587
HINGLISH_SAAS_SMTP_USER=
HINGLISH_SAAS_SMTP_PASSWORD=
HINGLISH_SAAS_MAIL_FROM=
HINGLISH_SAAS_SUPPORT_EMAIL=vineetkd418@gmail.com
HINGLISH_SAAS_SUPPORT_ADMIN_EMAILS=vineetkd418@gmail.com
HINGLISH_SAAS_SUPPORT_TOTP_SECRET=
HINGLISH_SAAS_LICENSE_PRIVATE_KEY=
HINGLISH_SAAS_DEVICE_LIMIT=1
